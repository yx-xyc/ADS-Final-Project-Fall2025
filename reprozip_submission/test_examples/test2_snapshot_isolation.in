// Test 2: Snapshot Isolation
// No aborts - all transactions use serializable snapshot isolation
// T2 reads initial values (x1=10, x2=20) because it reads from its snapshot
// T1 commits first with x1=101, x2=102
// T2 commits successfully - no conflicts

begin(T1)
begin(T2)
W(T1,x1,101)
R(T2,x2)
W(T1,x2,102)
R(T2,x1)
end(T1)
end(T2)
dump()

// Expected: T2 reads return x2=20, x1=10 (initial values from snapshot)
// Expected: Both T1 and T2 commit
// Expected: Final state - x1=101 at site 2, x2=102 at all sites
