// Test 3: Site Failure and Recovery
// T1 writes to x4 (replicated) - will go to all sites except site 2 (failed)
// T2 writes x8=88 before site 2 fails, then aborts when site 2 fails
// x8 will not have value 88 because T2 aborts

begin(T1)
begin(T2)
R(T1,x3)
W(T2,x8,88)
fail(2)
R(T2,x3)
W(T1,x4,91)
recover(2)
end(T2)
end(T1)

// Expected: T2 aborts (accessed site 2 which then failed)
// Expected: T1 commits (wrote to x4 on all sites except site 2)
// Expected: x4=91 at all sites except site 2 (which has x4=40)
// Expected: x8 remains 80 everywhere (T2's write lost due to abort)
