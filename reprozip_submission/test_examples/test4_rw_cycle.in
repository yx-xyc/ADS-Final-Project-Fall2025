// Test 4: RW Cycle Detection (Serialization Graph)
// Circular conflict where T5 creates a cycle
// T1 reads x1, writes x2; T2 reads x2, writes x3; T3 reads x3, writes x4
// T4 reads x4, writes x5; T5 reads x5, writes x1
// This creates: T5->T1->T2->T3->T4->T5 (cycle with all RW edges)
// T5 closes the cycle and must abort

begin(T1)
begin(T2)
begin(T3)
begin(T4)
begin(T5)
R(T4,x4)
R(T5,x5)
R(T1,x1)
W(T1,x2,10)
R(T2,x2)
W(T2,x3,20)
R(T3,x3)
W(T3,x4,30)
W(T4,x5,40)
W(T5,x1,50)
end(T4)
end(T3)
end(T2)
end(T1)
end(T5)

// Expected: T1, T2, T3, T4 all commit
// Expected: T5 aborts (creates cycle with two consecutive RW edges)
// Expected: Final state - x1=10 (initial), x2=10, x3=20, x4=30, x5=40
